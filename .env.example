# Copy to .env and fill in. Shared by backend, worker and infra/docker-compose.yml.
#   cp .env.example .env

# --- database -----------------------------------------------------------------
POSTGRES_USER=clip
POSTGRES_PASSWORD=clip
POSTGRES_DB=clip
POSTGRES_PORT=5445
DATABASE_URL=postgres://clip:clip@localhost:5445/clip

# --- api ----------------------------------------------------------------------
PORT=3014
# Bind 127.0.0.1 when fronted by nginx; 0.0.0.0 only if the box is firewalled.
HOST=127.0.0.1
# HMAC key for signed media URLs, and nothing else. It used to gate every /api
# route, but the SPA inlined it at build time, so it shipped in the JS bundle and
# was never secret; sessions replaced it. Still must be long and random.
# Generate one:  openssl rand -hex 32
API_TOKEN=

# --- google sign-in -----------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add this exact
# authorized redirect URI -- it is derived from PUBLIC_API_URL, not configured:
#   <PUBLIC_API_URL>/api/auth/google/callback
# Only the openid/email/profile scopes are requested, so the consent screen can
# be published without Google review.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# How long a login lasts. Nothing calls a Google API after sign-in, so there is
# no refresh token to keep alive.
SESSION_TTL_DAYS=30
# Per-user jobs per calendar month (UTC; resets on the 1st). Signup is open and
# the worker runs one job at a time, so this is what stops one account occupying
# the box.
QUOTA_JOBS_PER_MONTH=20
# Per-user rendered GB. Deleting a project gives this back (the files really are
# gone), unlike the monthly count above.
QUOTA_STORAGE_GB=5
# Comma-separated origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# --- Feature switches --------------------------------------------------------
#
# The clip editor: trimming, the timeline, manual clipping, save-as-new-clip.
# TEMPORARILY OFF while that page is reworked.
#
# One variable drives both halves. It hides the Edit chip (the only way in) and
# makes the editor-only API routes 404, so a bookmark or a direct call cannot
# reach the feature either. The frontend is a static build and reads this from
# GET /api/auth/me, so flipping it needs an API restart but NOT a rebuild.
#
# Unset means OFF, unlike every other flag here: the point of this switch is
# that nobody reaches the feature, so it must not be re-enabled by forgetting.
EDITOR_ENABLED=false

# Clip recommendations: the suggested-moments list under the clips on the
# results screen, and the chat that asks for a different set.
#
# Same two halves as EDITOR_ENABLED -- it hides the panel AND 404s the routes
# behind it, so a stale tab cannot reach them either. That matters more here
# than for the editor: asking for new recommendations calls the model, and a
# hidden panel is not a defence against something that costs money per request.
#
# DEFAULTS TO TRUE, unlike the switch above. The two exist for opposite reasons:
# the editor is off while it is reworked and must not come back by forgetting,
# whereas this is the lever to pull if the model bill needs stopping.
#
# Needs OPENROUTER_API_KEY below to be set in the API's environment too, not
# just the worker's. Without a key the panel loads but a chat turn answers 503.
RECOMMENDATIONS_ENABLED=true

# --- object storage ------------------------------------------------------------
#
# Storage is a LIST of backends, held in the storage_backends table and managed
# with `bun run storage` (add / verify / activate / remove). One backend is the
# active write target; every backend stays readable forever, so clips written
# before a move keep playing from where they are.
#
# Only credentials live here, one pair per backend id, so a database dump cannot
# carry them:
#
#   STORAGE_<ID>_ACCESS_KEY=...
#   STORAGE_<ID>_SECRET_KEY=...
#
# `bun run storage add` prints the exact two lines for the id you chose.
#
# The S3_* values below are the legacy single-backend settings. They still seed
# the 'minio' backend's credentials, which is what let the registry ship without
# an .env change; everything else about them is now advisory.
S3_ENDPOINT=http://localhost:9020
S3_REGION=us-east-1
S3_BUCKET=clips
S3_ACCESS_KEY=clipminio
S3_SECRET_KEY=clipminio123
# MinIO needs path-style addressing; real S3 does not.
S3_FORCE_PATH_STYLE=true
S3_PORT=9020
S3_CONSOLE_PORT=9021

# --- ai -----------------------------------------------------------------------
# Read by BOTH the worker (picking clips, where it is required) and the API
# (the recommendation chat, where it is optional -- a missing key disables that
# one panel with a 503 rather than stopping the boot).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- worker -------------------------------------------------------------------
# Scratch space for sources and intermediates. Deleted per job on finalize.
# Needs room for the source video plus its clips -- see MIN_FREE_DISK_GB.
# Relative to the WORKER's cwd (worker/), not the repo root.
WORK_DIR=./output/.work
# 4 cores: whisper and x264 each want all of them. Overlapping jobs make both
# slower and risk the OOM killer. Raise only on a bigger box.
WORKER_CONCURRENCY=1
# tiny | base | small  (medium+ is not viable on 4 CPU cores)
WHISPER_MODEL=base
# Blank = autodetect. Force with e.g. id, en, ru.
WHISPER_LANGUAGE=
WHISPER_THREADS=4
# --- GPU (NVIDIA) -------------------------------------------------------------
# Build the worker image with --build-arg GPU=1 and run it with the GPU mapped
# (podman --device nvidia.com/gpu=all / docker --gpus all). Leave all three
# unset on a CPU-only box.
#
# Measured on an RTX 5090 / 24 cores, 5-minute English source (wall time
# including model load; VRAM is the peak added on top of what was in use):
#   base            cpu int8   7.5s
#   small           cpu int8   56s
#   small           cuda fp16  6.6s   +1.5GB
#   medium          cuda fp16  7.8s   +2.7GB
#   large-v3-turbo  cuda fp16  4.8s   +2.7GB   <- use this on a GPU
#   large-v3        cuda fp16  18.3s  +5.7GB   (same text as turbo here)
# On a GPU set WHISPER_MODEL=large-v3-turbo. cuda with base is no faster
# than cpu -- the GPU only pays off with the bigger, more accurate models.
# cpu | cuda
WHISPER_DEVICE=cpu
# Blank = int8 on cpu, float16 on cuda. int8_float16 roughly halves VRAM if
# the GPU is shared and short on it.
WHISPER_COMPUTE_TYPE=
# libx264 | nvenc. nvenc was SLOWER than libx264 on the same box (see
# worker/src/ffmpeg.ts); use it only when CPU is the scarce resource.
VIDEO_ENCODER=libx264
# Refuse a job unless free disk is at least this many GB AND 3x the estimated
# source size. 14GB free with GB-scale VODs is the binding constraint here.
MIN_FREE_DISK_GB=5
# Abort if yt-dlp is older than this. YouTube rotates URL signing every few
# weeks; a stale build 403s partway through a multi-GB download.
YTDLP_MAX_AGE_DAYS=60
# Prefer YouTube auto-captions / subtitles when available (fast & accurate).
# Set to false to always force local Whisper transcription.
PREFER_YOUTUBE_SUBTITLES=true

# Publicly reachable origin of the API (nginx terminates TLS in front).
# Signed media URLs are built against this, so a wrong value yields links the
# browser cannot reach.
PUBLIC_API_URL=http://localhost:3014

# --- manual clipping: full-length source proxies --------------------------------
#
# Opening "Clip anywhere" builds a 240p proxy of the WHOLE source (~75-120MB per
# hour) so the editor can place its 150-second window anywhere in the video. The
# original is never stored: the render path re-downloads, as re-cut already does.
#
# Built lazily and shared per video, so a project nobody edits by hand costs
# nothing and two users editing the same URL share one build.
#
# Retention keeps the total under the budget, evicting whichever proxy has gone
# longest without being opened. An evicted proxy is rebuilt on demand, so the
# only cost of a low budget is time. `bun run proxies` shows what is stored.
#
# 6GB is sized for a box with ~20GB free shared with other applications: a long
# source can be an 8GB scratch DOWNLOAD on its own, and below MIN_FREE_DISK_GB
# the worker stops accepting jobs entirely.
PROXY_BUDGET_GB=6
PROXY_TTL_DAYS=30
# Never evict something opened this recently, even to get under budget.
PROXY_GRACE_MINUTES=30

# --- Cached source downloads -------------------------------------------------
#
# The worker keeps ORIGINAL downloads in WORK_DIR/sources so that opening the
# editor and then saving a trim do not download the same gigabytes twice. This
# is a separate budget from PROXY_BUDGET_GB above, on the same disk.
#
# The TTL is in MINUTES, not days. The cache exists to bridge one editing
# session -- open the editor, trim, save, trim again -- not to be a library, and
# holding 8GB for a session that ended starves the next download.
SOURCE_BUDGET_GB=8
SOURCE_TTL_MINUTES=60

# Which worker's disk a cached source lives on. Defaults to the machine's
# hostname, which is right for a single worker and for one container per host.
#
# SET IT EXPLICITLY, AND DIFFERENTLY, if you ever run two workers on one host:
# they would otherwise share a cache key while owning separate volumes. Getting
# this wrong costs a re-download, never a failed render -- reuse also requires
# the file to actually be there.
# WORKER_HOST_ID=worker-1
