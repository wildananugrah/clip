# clip2.mhamzah.id -- RETIRED. The app lives at clip2.id; this only redirects.
#
# Every request here is sent to the same path and query on https://clip2.id, so
# bookmarks, shared links and deep links (/login?error=..., a project URL) all
# keep working, just on the new name. 301, permanent: browsers and search
# engines update to the new address rather than asking again.
#
# Why redirect rather than keep serving the app here too: the app's own address
# is PUBLIC_API_URL=https://clip2.id, and Google sign-in returns to that host.
# Started on this domain, sign-in set its handshake cookies HERE and then came
# back to clip2.id without them, failing as "sign-in link expired". Serving one
# name is what makes sign-in work for everyone.
#
# NOT installed by scripts/deploy.sh, which syncs only deploy/nginx/clip2.id
# ($SITE). Install this by hand after changing it:
#
#   sudo cp deploy/nginx/clip2.mhamzah.id /etc/nginx/sites-available/
#   sudo nginx -t && sudo systemctl reload nginx

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name clip2.mhamzah.id;

  # Still needed: a browser has to complete TLS with this name before it can be
  # told to go elsewhere. certbot keeps renewing it as before.
  ssl_certificate /etc/letsencrypt/live/clip2.mhamzah.id/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/clip2.mhamzah.id/privkey.pem;

  return 301 https://clip2.id$request_uri;
}

server {
  listen 80;
  listen [::]:80;
  server_name clip2.mhamzah.id;

  # Straight to the new name, not via https://clip2.mhamzah.id first: one hop.
  return 301 https://clip2.id$request_uri;
}
