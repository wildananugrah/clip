{
  "name": "clip-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "start": "bun --env-file=../.env src/index.ts",
    "test": "bun test",
    "quota": "bun --env-file=../.env scripts/quota.ts",
    "projects": "bun --env-file=../.env scripts/projects.ts",
    "users": "bun --env-file=../.env scripts/users.ts",
    "storage": "bun --env-file=../.env scripts/storage.ts",
    "proxies": "bun --env-file=../.env scripts/proxies.ts",
    "jobs": "bun --env-file=../.env scripts/jobs.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=../.env src/db/migrate.ts",
    "db:push": "bun --env-file=../.env x drizzle-kit push",
    "db:studio": "bun --env-file=../.env x drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "archiver": "^7.0.1",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/bun": "^1.4.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0"
  }
}
